# frozen_string_literal: true

require "bundler/setup"
require "json"
require "bunny"
require_relative "../config/environment"
# Ensure Constants are loaded in production (Zeitwerk may not autoload files at app/ root)
require_relative "../app/constants"

# Robust connection with simple retries so we don't fail if RabbitMQ isn't
# ready exactly at container boot time.
def connect_bunny!(url)
  attempts = 0
  delays = [1, 2, 3, 5, 8]
  begin
    conn = Bunny.new(url)
    conn.start
    conn
  rescue Bunny::TCPConnectionFailed, Bunny::TCPConnectionFailedForAllHosts, Bunny::HostListDepleted, Errno::ECONNREFUSED => e
    delay = delays[attempts] || 10
    warn "[customer-consumer] rabbitmq connect failed: #{e.class} #{e.message}. retrying in #{delay}s"
    attempts += 1
    sleep delay
    retry
  end
end

conn = connect_bunny!(ENV.fetch("RABBITMQ_URL"))

ch = conn.create_channel
ch.prefetch(10)

exchange = ch.direct(Constants::ORDERS_EXCHANGE, durable: true)
queue = ch.queue(Constants::CUSTOMER_ORDERS_QUEUE, durable: true)
queue.bind(exchange, routing_key: Constants::ORDERS_CREATED_KEY)

puts "[customer-consumer] listening on #{Constants::CUSTOMER_ORDERS_QUEUE} (#{Constants::ORDERS_CREATED_KEY})"

queue.subscribe(manual_ack: true, block: true) do |delivery_info, _properties, body|
  payload = JSON.parse(body)
  Customers::OrdersCreatedHandler.call(payload)
  ch.ack(delivery_info.delivery_tag)
rescue JSON::ParserError => e
  warn "[customer-consumer] invalid JSON: #{e.message}"
  ch.ack(delivery_info.delivery_tag)
rescue => e
  warn "[customer-consumer] error: #{e.class} #{e.message}"
  ch.nack(delivery_info.delivery_tag, false, true) # requeue
end
